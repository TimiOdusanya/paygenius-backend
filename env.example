# ================================================
# PayGenius Backend Environment Variables
# ================================================

# Database Configuration
# ----------------------
MONGODB_URI=mongouri

# JWT Configuration
# -----------------
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-here-change-this-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Server Configuration
# --------------------
PORT=5000
NODE_ENV=development

# CORS Configuration
# ------------------
# Add your frontend URLs (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:8081,http://localhost:19006

# Twilio SMS Configuration
# -------------------------
# Get these from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Google OAuth Configuration
# ---------------------------
# CRITICAL: These must match your Google Cloud Console setup
# 
# Steps to get these credentials:
# 1. Go to https://console.cloud.google.com/
# 2. Select your project
# 3. Go to "APIs & Services" > "Credentials"
# 4. Find your "Web application" OAuth 2.0 Client ID
# 5. Click on it to view the Client ID and Client Secret
# 
# IMPORTANT NOTES:
# - Use the WEB Client ID, not Android or iOS Client IDs
# - The Client Secret should NEVER be exposed to the frontend
# - Keep this secret secure and never commit it to version control
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-web-client-secret

# Apple OAuth Configuration (Optional)
# -------------------------------------
# Required only if you want to support "Sign in with Apple"
# Get these from https://developer.apple.com/account/resources/identifiers/list
APPLE_CLIENT_ID=com.alfredpur.paygenuis
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=your-apple-private-key

# Email Configuration (Optional)
# -------------------------------
# If you want to send emails (e.g., for verification, notifications)
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_API_SECRET=your-mailjet-api-secret
MAILJET_SENDER_EMAIL=noreply@paygenius.com
MAILJET_SENDER_NAME=PayGenius

# Logging Configuration
# ----------------------
LOG_LEVEL=debug
LOG_FILE_PATH=./logs/app.log

# Rate Limiting
# -------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
# --------
# Set to true in production to enforce HTTPS
FORCE_HTTPS=false

# Paystack (wallet funding + account/card verification)
# -----------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_PREFERRED_BANK=test-bank

# VTpass (live airtime, data, electricity, TV billers)
# ----------------------------------------------------
# Docs: https://vtpass.com/documentation/
# Sandbox: https://sandbox.vtpass.com/api
# Live: https://vtpass.com/api
# GET  = api-key + public-key
# POST = api-key + secret-key
# Whitelist products on your VTpass dashboard before going live.
VTPASS_API_KEY=your-vtpass-api-key
VTPASS_PUBLIC_KEY=your-vtpass-public-key
VTPASS_SECRET_KEY=your-vtpass-secret-key
VTPASS_BASE_URL=https://sandbox.vtpass.com/api

# Expo Push Notifications
# -----------------------
# Push is sent via Expo's hosted API (https://exp.host/--/api/v2/push/send).
# No extra API key is required for standard Expo push tokens (ExponentPushToken / ExpoPushToken).

# Genie AI (OpenAI-compatible)
# ----------------------------
# Required for live Genie replies. If unset, Genie still answers from the user's
# wallet, budgets, savings, and loans using a contextual fallback.
# Works with OpenAI, Groq, Together, or any /v1/chat/completions provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
